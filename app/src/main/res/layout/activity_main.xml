<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/root_layout"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              tools:context=".MainActivity">

    <!-- Header bar: dosage as the title (fills the space), ingredients + action icons on the right.
         Transparent background so it blends with the content (no color seam). -->
    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@android:color/transparent"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/ingredients_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Ingredients ▾"
                android:textSize="12sp"
                android:visibility="gone" />

    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
            android:id="@+id/category_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorFullWidth="false" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/medication_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false"/>

    <!-- Gobble row: dose button + custom amount multiplier -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp">

        <Button
                android:id="@+id/gobble_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gobble" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Amount ×"
                android:textSize="16sp" />

        <EditText
                android:id="@+id/amount_input"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:inputType="numberDecimal"
                android:text="1"
                android:maxLines="1"
                android:importantForAutofill="no"
                android:hint="1"
                tools:ignore="LabelFor" />

        <Button
                android:id="@+id/amount_presets_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="▾"
                android:contentDescription="Amount presets" />

    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

        <TextView
                android:id="@+id/last_time_taken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Gobbled: N/A"
                android:textSize="16sp" />

        <TextView
                android:id="@+id/time_since_last_taken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Since Gobbled: N/A"
                android:textSize="16sp" />

        <TextView
                android:id="@+id/last_taken_mg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount Taken (24h): N/A"
                android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
